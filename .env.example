# Supabase Project Configuration
# Set these in your Vercel Project Settings -> Environment Variables

# Backend Server Environment Variables
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Frontend Client Environment Variables (Exposed to browser build)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Compatibility Aliases (optional, automatically resolved if above are set)
ZITE_SUPABASE_URL=https://your-project.supabase.co
ZITE_API_KEY=sb_secret_...
ZITE_SUPABASE_ANON_KEY=sb_publishable_...